# Strapi for native builds: localhost (iOS Simulator), http://10.0.2.2:1339 (Android emulator), http://<LAN-IP>:1339 (device)
EXPO_PUBLIC_STRAPI_URL=http://localhost:1339
# Strapi for the web build: the Strapi origin in development; empty in production (Vercel rewrites /api to Strapi)
EXPO_PUBLIC_WEB_API_BASE=http://localhost:1339
EXPO_PUBLIC_DEFAULT_CITY=las-vegas
# Public Mapbox token (pk.…), URL-restricted to the app's domains in production. Without it the app shows the list.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Build-time secret for native builds (sk.… with DOWNLOADS:READ). Never prefix it with EXPO_PUBLIC_.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=
