HOST=0.0.0.0
PORT=1339
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (local dev: SQLite; Strapi Cloud injects its Postgres settings)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Mapbox (admin map field)
MAPBOX_ACCESS_TOKEN=
MAPBOX_DEBUG_MODE=false
# Server-only token for geocoding school addresses (MCP upsert_school); no URL restriction. Falls back to MAPBOX_ACCESS_TOKEN.
MAPBOX_GEOCODING_TOKEN=

# Optional: path to a local strapi-plugin-map-box checkout (plugin development); leave empty to use the npm package
MAP_BOX_PLUGIN_PATH=

# Better Auth (end-user auth). BETTER_AUTH_URL is a bare origin; WEB_ORIGINS feeds CORS and trustedOrigins.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:1339
WEB_ORIGINS=http://localhost:8083
# Shared by dash() in src/lib/auth.ts and the admin's Better Auth dashboard. Required for the dashboard (it fails closed when empty).
BETTER_AUTH_DASHBOARD_SECRET=

# Strapi's MCP server (POST /mcp) for the curator's Claude tools
MCP_ENABLED=true
# What the MCP tools write goes live right away; false keeps it as drafts to publish in the admin
MATFINDER_AUTO_PUBLISH=true
# The gym chat ("Ask about this gym") and, later, the admin assistant: an Anthropic API key (server only, never in the
# app). Empty turns both chats off. Each chat has its own model; the default is claude-opus-5-5.
AI_API_KEY=
AI_GYM_CHAT_MODEL=
AI_ADMIN_CHAT_MODEL=
# Gym chat questions per day (UTC) from everyone together, counted in memory (a restart starts over). Empty = 200.
AI_GYM_CHAT_DAILY_TOTAL=

# Development only: seed the fictional Las Vegas sample data on boot (never on Strapi Cloud)
SEED_SAMPLE_DATA=false
