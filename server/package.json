{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "description": "A Strapi application",
  "scripts": {
    "build": "strapi build",
    "console": "strapi console",
    "deploy": "strapi deploy",
    "dev": "strapi develop",
    "develop": "strapi develop",
    "start": "strapi start",
    "strapi": "strapi",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:integration:isolated": "scripts/test-server.sh start && ALLOW_ADMIN_BOOTSTRAP=1 API_URL=http://localhost:1342 vitest run --config vitest.integration.config.mts; code=$?; scripts/test-server.sh stop; exit $code",
    "typecheck": "tsc --noEmit",
    "build:plugin": "cd src/plugins/matfinder && strapi-plugin build && node scripts/check-esm-import.mjs",
    "watch:plugin": "cd src/plugins/matfinder && strapi-plugin watch",
    "predevelop": "npm run build:plugin",
    "prebuild": "npm run build:plugin",
    "postinstall": "npm run build:plugin",
    "predev": "npm run build:plugin"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.7",
    "@better-auth/infra": "^0.2.14",
    "@strapi-community/plugin-api-permissions": "^1.0.0-alpha.5",
    "@strapi-community/plugin-better-auth": "^1.0.0-beta.7",
    "@strapi-community/plugin-better-auth-dashboard": "^1.0.0-beta.1",
    "@strapi/plugin-cloud": "5.58.0",
    "@strapi/strapi": "5.58.0",
    "@tanstack/ai": "0.71.0",
    "@tanstack/ai-anthropic": "0.23.0",
    "better-auth": "^1.7.7",
    "better-sqlite3": "12.4.1",
    "pg": "^8.23.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "strapi-plugin-map-box": "^0.0.5",
    "styled-components": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@strapi/sdk-plugin": "^5.4.0",
    "@types/node": "^24.19.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0 <=24.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "uuid": "ee9d704b-4aa1-4722-8df6-c15276463860",
    "installId": "062f25ba0f3482d341021428330fe282e2269d9474f1d9b4f1cc64315f3c435a"
  }
}
